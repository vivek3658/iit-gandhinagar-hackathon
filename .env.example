# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Security & OAuth
JWT_SECRET=super-secret-jwt-key-for-local-dev-min-32-chars!
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
CORS_ORIGIN=*

# ImageKit CDN (Client uploads directly using server-generated HMAC signatures)
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_secret_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/urjavatika

# Persistence (Optional / For full module stack)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urjavatika?schema=public
REDIS_URL=redis://localhost:6379
