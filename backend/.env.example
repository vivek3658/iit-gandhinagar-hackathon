# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Security & OAuth
JWT_SECRET=replace-with-a-random-secret-at-least-32-chars
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional initial platform-admin login. Store an scrypt hash, never a plaintext password.
ADMIN_USERNAME=urjaone
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
CRON_SECRET=replace-with-a-random-secret-at-least-32-chars
CORS_ORIGIN=*

# ImageKit CDN (Client uploads directly using server-generated HMAC signatures)
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_secret_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Persistence Tier - Supabase / PostgreSQL (Main ACID Storage)
# Option A: Direct PostgreSQL URI (for local docker / self-hosted)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@localhost:5432/urjavatika?schema=public
DATABASE_READ_URL=postgresql://postgres:[YOUR-PASSWORD]@localhost:5433/urjavatika?schema=public
# Option B: Supabase Direct Connection String (Port 5432)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Option C: Supabase Transaction / Session Pooler (Port 6543, recommended for serverless / Vercel)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# MongoDB (High-Velocity Activity Feed & TTL Buffers)
MONGODB_URL=mongodb://localhost:27017/urjavatika

# Redis (Atomic In-Memory Registers & Sub-millisecond Cache)
REDIS_URL=redis://localhost:6379

# RabbitMQ (Async Event Message Bus)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
