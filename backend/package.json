{
  "name": "urjavatika-backend",
  "version": "1.0.0",
  "description": "High-throughput Fastify v5 backend for UrjaVatika GEDA Mission LiFE citizen engagement platform",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "eslint src/ test/",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "fastify",
    "mission-life",
    "geda",
    "sustainability",
    "typescript"
  ],
  "author": "UrjaVatika Team",
  "license": "ISC",
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/env": "^5.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.14",
    "@types/node": "^22.13.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "google-auth-library": "^11.3.2",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "autocannon": "^8.0.0",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "tsx": "^4.19.3",
    "vitest": "^3.0.6"
  },
  "overrides": {
    "content-disposition": "0.5.4"
  }
}
